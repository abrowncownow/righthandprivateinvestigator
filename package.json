{
  "name": "right-hand-private-investigator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/run-astro.mjs dev",
    "start": "node scripts/run-astro.mjs dev",
    "check": "node scripts/run-astro.mjs check",
    "build": "node scripts/run-astro.mjs build",
    "build:preview": "node scripts/build-site.mjs preview",
    "build:production": "node scripts/build-site.mjs production",
    "preview": "node scripts/run-astro.mjs preview",
    "test": "node scripts/run-quality.mjs",
    "test:static": "node scripts/verify-builds.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:production": "node scripts/run-production-e2e.mjs",
    "test:e2e:built": "playwright test",
    "test:a11y": "node scripts/run-e2e.mjs tests/e2e/accessibility.spec.ts",
    "test:secrets": "secretlint \"**/*\" && node scripts/scan-secrets.mjs",
    "test:browsers": "playwright install chromium",
    "lighthouse": "node scripts/run-lighthouse.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "astro": "7.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "lighthouse": "13.4.1",
    "secretlint": "13.0.4",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  }
}
