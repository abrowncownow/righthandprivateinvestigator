---
import ArrowIcon from "@/components/ArrowIcon.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CtaBand from "@/components/CtaBand.astro";
import FaqList from "@/components/FaqList.astro";
import PageHero from "@/components/PageHero.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pathFor } from "@/utils/urls";

const individualFaqs = [
  { question: "Can you prove that a partner is being unfaithful?", answer: "Right Hand can document lawful observations within an agreed scope. Those observations may or may not answer the underlying question, and we cannot guarantee what another person will do during the assignment." },
  { question: "Can you access a phone, account, or private messages?", answer: "No. Right Hand does not hack accounts, obtain passwords, install spyware, intercept private communications, or use unlawful tracking or recording methods." },
  { question: "Will the person know they are being investigated?", answer: "We do not promise anonymity or undetectability. Any fieldwork can be noticed, and some information-gathering may create records or require contact with others. We discuss material risks before work begins." },
  { question: "What information do you need from me?", answer: "Begin with your objective, the general location, relevant dates, and why you are seeking the information. Additional information should be shared only after the assignment is accepted and an appropriate delivery method is agreed." },
  { question: "Does contacting you make me a client?", answer: "No. A client relationship begins only when Right Hand accepts the matter in writing and any required agreement and payment arrangements are completed." }
];
---

<BaseLayout
  title="Private Investigation Support for Individuals | Right Hand"
  description="Lawful, carefully planned investigative support for relationship concerns, family matters, locates, and personal due diligence in Idaho."
  schemaType="CollectionPage"
>
  <Breadcrumbs current="Individuals" />
  <PageHero eyebrow="For individuals" title="Clear answers begin with a careful plan." lead="When something personal feels uncertain, you deserve a straightforward conversation about what can lawfully be investigated, what it may cost, and what the work can—and cannot—establish." index="FIELD / IND">
    <div slot="actions" class="button-row">
      <a class="button button--paper" href={pathFor("/contact/?audience=individual")}>Talk through your situation <ArrowIcon /></a>
      <a class="button button--outline-light" href="#personal-services">See individual services <ArrowIcon /></a>
    </div>
    <aside slot="aside" class="hero-assurance">
      <span>YOU CAN START HIGH LEVEL</span>
      <p>You do not need to tell the whole story online. A short call or brief message is enough to determine whether a fuller consultation makes sense.</p>
    </aside>
  </PageHero>

  <section id="personal-services" class="section section--paper">
    <div class="shell">
      <SectionIntro index="01" eyebrow="Personal matters" title="Sensitive questions. Straightforward boundaries." copy="The work begins with a defined concern and a realistic conversation about what lawful fact-gathering may—and may not—show." />
      <div class="matter-grid">
        <article class="matter-card matter-card--featured">
          <span>01 / RELATIONSHIPS</span>
          <h3>Relationship & infidelity concerns</h3>
          <p>Lawful surveillance and field observations may document activity visible from public or otherwise authorized locations.</p>
          <small>No investigator can promise what will occur, guarantee a particular answer, or ensure that fieldwork will never be noticed.</small>
          <a class="text-link text-link--light" href={pathFor("/contact/?matter=infidelity")}>Discuss your question <ArrowIcon /></a>
        </article>
        <article class="matter-card">
          <span>02 / FAMILY</span>
          <h3>Family & custody matters</h3>
          <p>Fact-gathering may support questions involving conduct, routines, locations, or other defined concerns.</p>
          <small>When litigation or a court order is involved, coordination with your attorney may be appropriate. Right Hand does not interpret court orders or give legal advice.</small>
        </article>
        <article class="matter-card">
          <span>03 / LOCATES</span>
          <h3>Locates & missing-person matters</h3>
          <p>Requests are reviewed for identity, relationship, purpose, and safety before any work begins.</p>
          <small>A person’s location may be withheld or provided only through an appropriate intermediary when disclosure could create risk or facilitate harassment.</small>
        </article>
        <article class="matter-card">
          <span>04 / DUE DILIGENCE</span>
          <h3>Personal due diligence</h3>
          <p>Lawful public-record and open-source research can help verify claims or identify inconsistencies before an important personal decision.</p>
          <small>This is not a consumer report and is not offered for employment, housing, credit, insurance eligibility, or another regulated screening purpose.</small>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--light expectation-section">
    <div class="shell expectation-grid">
      <SectionIntro index="02" eyebrow="What to expect" title="A process that stays grounded." copy="You should know what is being proposed, what the limitations are, and what kind of findings you may receive before work starts." />
      <ol>
        <li><span>01</span><p>Begin with a high-level, judgment-free conversation.</p></li>
        <li><span>02</span><p>Receive a realistic explanation of options and limitations.</p></li>
        <li><span>03</span><p>Approve a written scope before investigative work starts.</p></li>
        <li><span>04</span><p>Get factual findings without speculation presented as fact.</p></li>
        <li><span>05</span><p>Decide the next step with your attorney or another qualified adviser when appropriate.</p></li>
      </ol>
    </div>
  </section>

  <section class="section section--dark sensitive-section">
    <div class="shell sensitive-grid">
      <div class="sensitive-symbol" aria-hidden="true"><span>i</span></div>
      <div>
        <p class="eyebrow eyebrow--light"><span>03</span> Before you contact us</p>
        <h2>Keep the first message simple.</h2>
        <p>Share the goal, general location, relevant dates, and any deadline. Do not send Social Security numbers, full birth dates, account credentials, financial or medical records, intimate images, evidence uploads, or tracking links unless the matter has been accepted and you receive specific instructions.</p>
        <a class="button button--paper" href={pathFor("/contact/")}>See contact guidance <ArrowIcon /></a>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="shell faq-grid">
      <SectionIntro index="04" eyebrow="Questions" title="What people often ask first." copy="Investigative work has real practical and legal limits. These answers are a useful place to begin." />
      <FaqList items={individualFaqs} />
    </div>
  </section>

  <section class="safety-band">
    <div class="shell safety-band__inner">
      <span>IMMEDIATE SAFETY</span>
      <div><h2>If safety is at risk, act now.</h2><p>This website is not an emergency service. If you or someone else is in immediate danger, call 911. Do not confront a person or put yourself at risk to collect evidence.</p></div>
    </div>
  </section>

  <CtaBand title="You can start without telling the whole story online." copy="A short phone call or high-level message is enough to determine whether a fuller consultation makes sense." primaryLabel="Talk with Right Hand" />
</BaseLayout>

<style>
  .hero-assurance { padding-left: 1.5rem; border-left: 2px solid var(--copper-light); }
  .hero-assurance span { color: var(--copper-light); font-size: 0.65rem; font-weight: 800; letter-spacing: 0.12em; }
  .hero-assurance p { margin: 1rem 0 0; color: var(--sage-light); font-size: 0.88rem; }
  .matter-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; margin-top: 3.5rem; }
  .matter-card { display: flex; min-height: 25rem; flex-direction: column; padding: clamp(1.75rem, 4vw, 3rem); border: 1px solid var(--line-strong); background: var(--paper-light); }
  .matter-card--featured { color: var(--paper-light); background: var(--pine-900); }
  .matter-card > span { color: var(--copper-dark); font-size: 0.67rem; font-weight: 800; letter-spacing: 0.12em; }
  .matter-card--featured > span { color: var(--copper-light); }
  .matter-card h3 { max-width: 15ch; margin: 3.5rem 0 0; font-size: clamp(2rem, 3.5vw, 3.2rem); }
  .matter-card p { color: color-mix(in srgb, currentColor 77%, transparent); }
  .matter-card small { margin-top: auto; padding-top: 1rem; border-top: 1px solid color-mix(in srgb, currentColor 20%, transparent); color: color-mix(in srgb, currentColor 67%, transparent); font-size: 0.76rem; }
  .matter-card .text-link { margin-top: 1.2rem; }
  .expectation-grid { display: grid; grid-template-columns: 0.72fr 1fr; gap: clamp(3rem, 9vw, 9rem); }
  .expectation-grid ol { margin: 0; padding: 0; border-top: 1px solid var(--line-strong); list-style: none; }
  .expectation-grid li { display: grid; grid-template-columns: 3rem 1fr; align-items: center; gap: 1rem; min-height: 5rem; border-bottom: 1px solid var(--line-strong); }
  .expectation-grid li span { color: var(--copper-dark); font-size: 0.67rem; font-weight: 800; }
  .expectation-grid li p { margin: 0; }
  .sensitive-grid { display: grid; grid-template-columns: 0.42fr 1fr; align-items: center; gap: clamp(3rem, 9vw, 9rem); }
  .sensitive-symbol { display: grid; width: min(100%, 17rem); aspect-ratio: 1; place-items: center; border: 1px solid rgb(255 255 255 / 30%); border-radius: 50%; }
  .sensitive-symbol span { color: var(--copper-light); font-family: var(--font-display); font-size: 8rem; font-style: italic; line-height: 1; }
  .sensitive-grid h2 { max-width: 14ch; margin: 0; color: var(--paper-light); }
  .sensitive-grid p:not(.eyebrow) { max-width: 50rem; color: var(--sage-light); }
  .sensitive-grid .button { margin-top: 1rem; }
  .faq-grid { display: grid; grid-template-columns: 0.72fr 1fr; gap: clamp(3rem, 9vw, 9rem); }
  .safety-band { padding-block: 3rem; color: var(--paper-light); background: var(--copper-dark); }
  .safety-band__inner { display: grid; grid-template-columns: 0.35fr 1fr; gap: 2rem; align-items: start; }
  .safety-band__inner > span { padding-top: 0.5rem; font-size: 0.67rem; font-weight: 800; letter-spacing: 0.12em; }
  .safety-band h2 { margin: 0; font-size: clamp(2rem, 3.5vw, 3.3rem); }
  .safety-band p { max-width: 49rem; margin-bottom: 0; color: color-mix(in srgb, var(--paper) 83%, transparent); }
  @media (max-width: 48rem) {
    .matter-grid, .expectation-grid, .sensitive-grid, .faq-grid, .safety-band__inner { grid-template-columns: 1fr; }
    .matter-card { min-height: 23rem; }
    .sensitive-symbol { width: 9rem; }
    .sensitive-symbol span { font-size: 4rem; }
  }
</style>
