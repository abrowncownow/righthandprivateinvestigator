---
import ArrowIcon from "@/components/ArrowIcon.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CtaBand from "@/components/CtaBand.astro";
import FaqList from "@/components/FaqList.astro";
import PageHero from "@/components/PageHero.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pathFor } from "@/utils/urls";

const individualFaqs = [
  { question: "Can you help with a relationship concern?", answer: "Yes. Right Hand can document relevant activity and patterns through discreet, lawful fieldwork. We will explain what can reasonably be investigated and design the work around your question, timing, and budget." },
  { question: "Can you access a phone, account, or private messages?", answer: "No. Right Hand does not hack accounts, obtain passwords, install spyware, intercept private communications, or use unlawful tracking or recording methods." },
  { question: "Will the person know they are being investigated?", answer: "Discretion is central to the plan. Because any fieldwork carries some chance of being noticed, we will explain the practical risks and available options before you authorize the work." },
  { question: "What information do you need from me?", answer: "Start with what is happening, what you hope to understand, the general location, relevant dates, and any deadline. A brief phone call or email is enough for the first conversation." },
  { question: "What happens after I contact you?", answer: "We will listen, ask a few questions, and explain whether an investigation may help. If you decide to proceed, you will receive a clear scope, expected cost, and next steps before work begins." }
];
---

<BaseLayout
  title="Private Investigation Support for Individuals | Right Hand"
  description="Discreet, personal investigative help for relationship concerns, family matters, locates, wellness verification, background research, and electronic surveillance concerns in Idaho."
  schemaType="CollectionPage"
>
  <Breadcrumbs current="Individuals" />
  <PageHero eyebrow="For individuals" title="When something doesn’t add up, you don’t have to sort it out alone." lead="Tell us what is happening and what you need to understand. You’ll get a judgment-free conversation, practical options, and a clear next step." index="FIELD / IND">
    <div slot="actions" class="button-row">
      <a class="button button--paper" href={pathFor("/contact/?audience=individual")}>Talk through your situation <ArrowIcon /></a>
      <a class="button button--outline-light" href="#personal-services">See individual services <ArrowIcon /></a>
    </div>
    <aside slot="aside" class="hero-assurance">
      <span>A CONVERSATION IS ENOUGH</span>
      <p>You do not need investigative terminology or a perfectly organized story. A short call or email is enough to get started.</p>
    </aside>
  </PageHero>

  <section id="personal-services" class="section section--paper">
    <div class="shell">
      <SectionIntro index="01" eyebrow="Personal matters" title="Sensitive questions deserve clear, discreet support." copy="Right Hand helps turn uncertainty into a practical plan—without judgment, pressure, or investigative jargon." />
      <div class="matter-grid">
        <article class="matter-card matter-card--featured">
          <span>01 / RELATIONSHIPS</span>
          <h3>Relationship & infidelity concerns</h3>
          <p>Discreet field observations can document relevant activity, patterns, and meetings so you can make decisions with better information.</p>
          <small>The plan is tailored to your question, timing, and budget.</small>
          <a class="text-link text-link--light" href={pathFor("/contact/?audience=individual&matter=infidelity")}>Talk through your situation <ArrowIcon /></a>
        </article>
        <article class="matter-card">
          <span>02 / FAMILY</span>
          <h3>Family & custody matters</h3>
          <p>Fact-based documentation of relevant conduct, routines, or locations can support personal decisions and active family matters.</p>
          <small>When a case is already underway, investigative work can be coordinated with your attorney.</small>
        </article>
        <article class="matter-card">
          <span>03 / LOCATES + CHECKS</span>
          <h3>Locates & wellness verification</h3>
          <p>Whether you are trying to reconnect, resolve a family or estate matter, or confirm that someone is alive and well, Right Hand can develop reliable leads and conduct a discreet field check when appropriate.</p>
          <small>Tell us who you are concerned about and what you need to learn. We will explain the practical options.</small>
        </article>
        <article class="matter-card">
          <span>04 / DUE DILIGENCE</span>
          <h3>Personal background research</h3>
          <p>Public records, criminal court records, and social media research can help verify claims, identify inconsistencies, and give you more context before an important personal decision.</p>
          <small>Research depth is matched to the decision you are facing.</small>
        </article>
        <article class="matter-card">
          <span>05 / PRIVACY</span>
          <h3>Suspected cameras, microphones, or trackers</h3>
          <p>If you are concerned that a home, vehicle, or other space may be monitored, Right Hand can discuss an authorized inspection for signs of electronic surveillance.</p>
          <small>Start with where the concern arose and the location you are authorized to have inspected.</small>
          <a class="text-link" href={pathFor("/contact/?audience=individual&matter=detection")}>Discuss your concern <ArrowIcon /></a>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--light expectation-section">
    <div class="shell expectation-grid">
      <SectionIntro index="02" eyebrow="What to expect" title="A simple, straightforward process." copy="You will know what is recommended, what it will cost, and what you can expect to receive before deciding whether to move forward." />
      <ol>
        <li><span>01</span><p>Tell us what is happening and what you want to understand.</p></li>
        <li><span>02</span><p>Hear the practical options, timing, and expected cost.</p></li>
        <li><span>03</span><p>Choose a clear plan that fits your situation.</p></li>
        <li><span>04</span><p>Receive updates as the agreed work moves forward.</p></li>
        <li><span>05</span><p>Get organized findings that help you decide what comes next.</p></li>
      </ol>
    </div>
  </section>

  <section class="section section--dark sensitive-section">
    <div class="shell sensitive-grid">
      <div class="sensitive-symbol" aria-hidden="true"><span>i</span></div>
      <div>
        <p class="eyebrow eyebrow--light"><span>03</span> Start the conversation</p>
        <h2>A few details are enough to begin.</h2>
        <p>Share what you want to understand, the general location, relevant dates, and any deadline. To protect your privacy, wait to send sensitive records or identifying information until the next step is explained.</p>
        <a class="button button--paper" href={pathFor("/contact/?audience=individual")}>Start a conversation <ArrowIcon /></a>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="shell faq-grid">
      <SectionIntro index="04" eyebrow="Questions" title="What you may want to know before calling." copy="These are common questions, but you are always welcome to talk through your specific situation with us." />
      <FaqList items={individualFaqs} />
    </div>
  </section>

  <section class="safety-band">
    <div class="shell safety-band__inner">
      <span>IMMEDIATE SAFETY</span>
      <div><h2>If safety is at risk, act now.</h2><p>This website is not an emergency service. If you or someone else is in immediate danger, call 911. Do not confront a person or put yourself at risk to collect evidence.</p></div>
    </div>
  </section>

  <CtaBand title="Ready to talk it through?" copy="A short, judgment-free conversation is enough to understand your options and decide what comes next." primaryLabel="Talk with Right Hand" />
</BaseLayout>

<style>
  .hero-assurance { padding-left: 1.5rem; border-left: 2px solid var(--copper-light); }
  .hero-assurance span { color: var(--copper-light); font-size: 0.65rem; font-weight: 800; letter-spacing: 0.12em; }
  .hero-assurance p { margin: 1rem 0 0; color: var(--sage-light); font-size: 0.88rem; }
  .matter-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; margin-top: 3.5rem; }
  .matter-card { display: flex; min-height: 25rem; flex-direction: column; padding: clamp(1.75rem, 4vw, 3rem); border: 1px solid var(--line-strong); background: var(--paper-light); }
  .matter-card--featured { color: var(--paper-light); background: var(--pine-900); }
  .matter-card > span { color: var(--copper-dark); font-size: 0.67rem; font-weight: 800; letter-spacing: 0.12em; }
  .matter-card--featured > span { color: var(--copper-light); }
  .matter-card h3 { max-width: 15ch; margin: 3.5rem 0 0; font-size: clamp(2rem, 3.5vw, 3.2rem); }
  .matter-card p { color: color-mix(in srgb, currentColor 77%, transparent); }
  .matter-card small { margin-top: auto; padding-top: 1rem; border-top: 1px solid color-mix(in srgb, currentColor 20%, transparent); color: color-mix(in srgb, currentColor 67%, transparent); font-size: 0.76rem; }
  .matter-card .text-link { margin-top: 1.2rem; }
  .expectation-grid { display: grid; grid-template-columns: 0.72fr 1fr; gap: clamp(3rem, 9vw, 9rem); }
  .expectation-grid ol { margin: 0; padding: 0; border-top: 1px solid var(--line-strong); list-style: none; }
  .expectation-grid li { display: grid; grid-template-columns: 3rem 1fr; align-items: center; gap: 1rem; min-height: 5rem; border-bottom: 1px solid var(--line-strong); }
  .expectation-grid li span { color: var(--copper-dark); font-size: 0.67rem; font-weight: 800; }
  .expectation-grid li p { margin: 0; }
  .sensitive-grid { display: grid; grid-template-columns: 0.42fr 1fr; align-items: center; gap: clamp(3rem, 9vw, 9rem); }
  .sensitive-symbol { display: grid; width: min(100%, 17rem); aspect-ratio: 1; place-items: center; border: 1px solid rgb(255 255 255 / 30%); border-radius: 50%; }
  .sensitive-symbol span { color: var(--copper-light); font-family: var(--font-display); font-size: 8rem; font-style: italic; line-height: 1; }
  .sensitive-grid h2 { max-width: 14ch; margin: 0; color: var(--paper-light); }
  .sensitive-grid p:not(.eyebrow) { max-width: 50rem; color: var(--sage-light); }
  .sensitive-grid .button { margin-top: 1rem; }
  .faq-grid { display: grid; grid-template-columns: 0.72fr 1fr; gap: clamp(3rem, 9vw, 9rem); }
  .safety-band { padding-block: 3rem; color: var(--paper-light); background: var(--copper-dark); }
  .safety-band__inner { display: grid; grid-template-columns: 0.35fr 1fr; gap: 2rem; align-items: start; }
  .safety-band__inner > span { padding-top: 0.5rem; font-size: 0.67rem; font-weight: 800; letter-spacing: 0.12em; }
  .safety-band h2 { margin: 0; font-size: clamp(2rem, 3.5vw, 3.3rem); }
  .safety-band p { max-width: 49rem; margin-bottom: 0; color: color-mix(in srgb, var(--paper) 83%, transparent); }
  @media (max-width: 48rem) {
    .matter-grid, .expectation-grid, .sensitive-grid, .faq-grid, .safety-band__inner { grid-template-columns: 1fr; }
    .matter-card { min-height: 23rem; }
    .sensitive-symbol { width: 9rem; }
    .sensitive-symbol span { font-size: 4rem; }
  }
</style>
