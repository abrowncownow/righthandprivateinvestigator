---
import ArrowIcon from "@/components/ArrowIcon.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CtaBand from "@/components/CtaBand.astro";
import PageHero from "@/components/PageHero.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import { publishedServices, serviceStandards } from "@/data/services";
import { siteConfig } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pathFor } from "@/utils/urls";
---

<BaseLayout
  title="Private Investigation Services in Idaho | Right Hand"
  description="Explore surveillance, activity checks, person locates, background research, witness interviews, IME support, and electronic surveillance detection."
  schemaType="CollectionPage"
>
  <Breadcrumbs current="Services" />
  <PageHero eyebrow="Capabilities" title="Focused services. Clearly defined assignments." lead="Start with what you need to understand. We will recommend a practical investigative approach based on the objective, location, timing, and reporting needs." index="FIELD / SVC">
    <div slot="actions" class="button-row">
      <a class="button button--paper" href={pathFor("/contact/#contact-form")}>Discuss your objective <ArrowIcon /></a>
      <a class="button button--outline-light" href="#service-list">Review services <ArrowIcon /></a>
    </div>
    <aside slot="aside" class="service-legend">
      <p>You do not need to know which service fits. Start with the outcome or information you need.</p>
      <div><span></span> Organizations</div>
      <div><span></span> Individuals</div>
    </aside>
  </PageHero>

  <section id="service-list" class="section section--paper">
    <div class="shell">
      <SectionIntro index="01" eyebrow="Service list" title="Work shaped around your objective." copy="Each capability can stand alone or become part of a broader plan. We will explain what fits, what it costs, and what the finished work can include." />
      <div class="services-full-grid">
        {publishedServices.map((service) => (
          <div id={service.slug}><ServiceCard service={service} /></div>
        ))}
      </div>
      <aside class="process-handoff">
        <div>
          <p class="eyebrow"><span>PROCESS / SERVICE</span> A connected service</p>
          <h2>Need legal documents served?</h2>
          <p>Process service is handled through Right Hand Professional Process Service, with coverage and ordering details available on its separate website.</p>
        </div>
        <a class="button" href={siteConfig.processServiceUrl} target="_blank" rel="noopener noreferrer">Visit the process-service website <ArrowIcon external /></a>
      </aside>
    </div>
  </section>

  <section class="section section--dark exclusions-section">
    <div class="shell exclusions-grid">
      <div>
        <p class="eyebrow eyebrow--light"><span>02</span> Professional standards</p>
        <h2>Clear methods make stronger findings.</h2>
        <p>Right Hand sets the purpose, scope, and reporting plan up front, then uses responsible methods that fit the assignment.</p>
      </div>
      <ul>
        {serviceStandards.map((item, index) => <li><span>{String(index + 1).padStart(2, "0")}</span>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--sage question-section">
    <div class="shell question-grid">
      <span class="question-mark" aria-hidden="true">?</span>
      <div><p class="eyebrow"><span>03</span> Not sure what fits?</p><h2>Start with what you need to know.</h2><p>Tell us what you are trying to understand, where the matter is located, and whether there is a deadline. We will translate that objective into clear options and a practical next step.</p><a class="button" href={pathFor("/contact/#contact-form")}>Start a conversation <ArrowIcon /></a></div>
    </div>
  </section>

  <CtaBand title="Put the question in the Right Hands." copy="Start with what you need to understand, the general location, and any important timing. We will help shape the next step." primaryLabel="Discuss your objective" />
</BaseLayout>

<style>
  .service-legend { padding: 1.5rem; border: 1px solid rgb(255 255 255 / 24%); }
  .service-legend p { margin: 0 0 1.25rem; color: var(--sage-light); font-size: 0.82rem; }
  .service-legend div { display: flex; align-items: center; gap: 0.6rem; padding-block: 0.4rem; color: var(--paper); font-size: 0.72rem; font-weight: 750; text-transform: uppercase; }
  .service-legend div span { width: 0.55rem; height: 0.55rem; border: 1px solid var(--copper-light); transform: rotate(45deg); }
  .services-full-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; margin-top: 4rem; }
  .process-handoff { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 2rem; margin-top: 1.25rem; padding: clamp(1.75rem, 4vw, 3rem); border: 1px solid var(--line-strong); background: var(--sage-light); }
  .process-handoff h2 { margin: 0; }
  .process-handoff p:not(.eyebrow) { max-width: 48rem; margin-bottom: 0; color: var(--ink); }
  .process-handoff .button { white-space: nowrap; }
  .exclusions-grid { display: grid; grid-template-columns: 0.78fr 1fr; gap: clamp(3rem, 9vw, 9rem); }
  .exclusions-grid h2 { max-width: 13ch; margin: 0; color: var(--paper-light); }
  .exclusions-grid > div > p:last-child { max-width: 35rem; color: var(--sage-light); }
  .exclusions-grid ul { margin: 0; padding: 0; border-top: 1px solid rgb(255 255 255 / 23%); list-style: none; }
  .exclusions-grid li { display: grid; grid-template-columns: 2.5rem 1fr; gap: 1rem; padding-block: 1rem; border-bottom: 1px solid rgb(255 255 255 / 23%); color: var(--paper); font-size: 0.9rem; }
  .exclusions-grid li span { color: var(--copper-light); font-size: 0.67rem; font-weight: 800; }
  .question-grid { display: grid; grid-template-columns: 0.4fr 1fr; align-items: center; gap: clamp(3rem, 9vw, 9rem); }
  .question-mark { display: grid; width: min(100%, 16rem); aspect-ratio: 1; place-items: center; border: 1px solid var(--pine-800); border-radius: 50%; font-family: var(--font-display); font-size: 8rem; font-style: italic; }
  .question-grid h2 { max-width: 16ch; margin: 0; }
  .question-grid p:not(.eyebrow) { max-width: 50rem; color: var(--ink-muted); }
  .question-grid .button { margin-top: 1rem; }
  @media (max-width: 48rem) {
    .services-full-grid, .process-handoff, .exclusions-grid, .question-grid { grid-template-columns: 1fr; }
    .process-handoff { align-items: start; }
    .process-handoff .button { justify-self: start; white-space: normal; }
    .question-mark { width: 9rem; font-size: 4rem; }
  }
</style>
