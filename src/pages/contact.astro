---
import ArrowIcon from "@/components/ArrowIcon.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ContactForm from "@/components/ContactForm.astro";
import PageHero from "@/components/PageHero.astro";
import SectionIntro from "@/components/SectionIntro.astro";
import { siteConfig } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Contact Right Hand Private Investigator" description="Request a consultation about an Idaho investigation. Share a brief overview through our contact form to discuss your options and next steps." schemaType="ContactPage">
  <Breadcrumbs current="Contact" />
  <div class="contact-intro">
    <PageHero eyebrow="Contact a private investigator" title="Tell us what you need to find out." lead="Start with the form below. Share a brief overview, and we will follow up to discuss your options, expected costs, and next steps." index="FIELD / CNT">
      <div slot="actions" class="button-row">
        <a class="button button--paper" href="#contact-form">Request a consultation <ArrowIcon /></a>
        <a class="button button--outline-light" href="#direct-contact">Prefer to call or email? <ArrowIcon /></a>
      </div>
      <aside slot="aside" class="contact-aside"><span>REQUEST A CONSULTATION</span><strong>Right Hand Private Investigator</strong><p>Idaho-focused service · Discreet, practical guidance</p></aside>
    </PageHero>
  </div>

  <section class="section section--sage intake-section">
    <div class="shell intake-grid">
      <SectionIntro index="01" eyebrow="Start the conversation" title="Tell us how we can help." copy="Complete the form with a brief overview of what you need to find out. If the matter appears to be a fit, we will discuss the details, scope, and expected cost." />
      <div id="contact-form"><ContactForm /></div>
    </div>
  </section>

  <section id="direct-contact" class="section section--paper contact-options">
    <div class="shell">
      <SectionIntro index="02" eyebrow="Direct contact" title="Prefer to call or email?" copy="You can also reach us directly. Your inquiry will be handled discreetly, with a straightforward conversation about whether an investigation is the right next step." />
      <div class="contact-cards">
        <a href={`tel:${siteConfig.phoneHref}`}><span>CALL</span><h3>{siteConfig.phoneDisplay}</h3><p>Talk through what is happening, what you need to understand, and any important timing.</p><strong>Call Right Hand <ArrowIcon /></strong></a>
        <a href={`mailto:${siteConfig.email}`}><span>EMAIL</span><h3>{siteConfig.email}</h3><p>Send a brief overview, the general location, and any important deadline. We will follow up about the next step.</p><strong>Email Right Hand <ArrowIcon /></strong></a>
      </div>
    </div>
  </section>

  <section class="section section--light guidance-section">
    <div class="shell guidance-grid">
      <div><p class="eyebrow"><span>03</span> Helpful details</p><h2>What to include.</h2><ul class="rule-list"><li>What you want to understand or document</li><li>City, county, or region where work may be needed</li><li>Relevant dates, timing, or deadline</li><li>Whether an attorney, insurer, employer, or public organization is involved</li></ul></div>
      <div class="do-not-send"><p class="eyebrow"><span>04</span> Protect your privacy</p><h2>Start with the essentials.</h2><p>A short overview is enough for the first conversation. Please wait to send sensitive records, identifying information, intimate material, or case files until we explain how they should be shared.</p></div>
    </div>
  </section>

  <section class="emergency-band"><div class="shell"><span>EMERGENCY / SAFETY</span><p>Do not use this site for an emergency or immediate safety issue. Call 911 if someone is in immediate danger.</p></div></section>
</BaseLayout>

<style>
  .contact-intro :global(.page-hero) { padding-block: clamp(2rem, 4vw, 3.5rem); }
  .contact-intro :global(.page-hero h1) { max-width: 20ch; font-size: clamp(2.6rem, 5vw, 4.5rem); }
  .intake-section { padding-top: clamp(2rem, 4vw, 3.5rem); }
  .contact-aside { padding-left: 1.5rem; border-left: 2px solid var(--copper-light); }
  .contact-aside span { color: var(--copper-light); font-size: 0.65rem; font-weight: 800; letter-spacing: 0.12em; }
  .contact-aside strong { display: block; margin-top: 1rem; font-family: var(--font-display); font-size: 1.55rem; font-weight: 520; }
  .contact-aside p { color: var(--sage-light); font-size: 0.8rem; }
  .contact-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; margin-top: 3rem; }
  .contact-cards > a { display: flex; min-height: 23rem; flex-direction: column; padding: clamp(1.75rem, 4vw, 3rem); border: 1px solid var(--line-strong); color: var(--ink); background: var(--paper-light); text-decoration: none; transition: transform 160ms ease, box-shadow 160ms ease; }
  .contact-cards > a:hover { transform: translateY(-3px); box-shadow: var(--shadow-raised); }
  .contact-cards span { color: var(--copper-dark); font-size: 0.65rem; font-weight: 800; letter-spacing: 0.12em; }
  .contact-cards h3 { overflow-wrap: anywhere; margin: 4rem 0 0; font-size: clamp(1.8rem, 3vw, 2.7rem); }
  .contact-cards p { color: var(--ink-muted); }
  .contact-cards strong { display: flex; align-items: center; justify-content: space-between; margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--line); font-size: 0.77rem; }
  .guidance-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(3rem, 8vw, 8rem); }
  .guidance-grid h2 { margin: 0 0 2rem; }
  .do-not-send { padding: clamp(1.5rem, 4vw, 3rem); border: 1px solid var(--red); border-left-width: 0.35rem; background: var(--paper); }
  .intake-grid { display: grid; grid-template-columns: 0.62fr 1fr; align-items: start; gap: clamp(3rem, 8vw, 8rem); }
  .emergency-band { color: var(--paper-light); background: var(--red-dark); }
  .emergency-band .shell { display: grid; grid-template-columns: 0.35fr 1fr; align-items: center; gap: 2rem; min-height: 6rem; }
  .emergency-band span { font-size: 0.65rem; font-weight: 800; letter-spacing: 0.12em; }
  .emergency-band p { margin: 0; }
  @media (max-width: 48rem) { .contact-cards, .guidance-grid, .intake-grid, .emergency-band .shell { grid-template-columns: 1fr; } .emergency-band .shell { gap: 0; padding-block: 1rem; } }
</style>
