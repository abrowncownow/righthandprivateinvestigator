---
import { pathFor } from "@/utils/urls";

interface Props {
  compact?: boolean;
  inverted?: boolean;
}

const { compact = false, inverted = false } = Astro.props;
---

<a class:list={["brand", { compact, inverted }]} href={pathFor("/")} aria-label="Right Hand Private Investigator home">
  <span class="brand-mark" aria-hidden="true">
    <span>RH</span>
  </span>
  <span class="brand-copy">
    <strong>RIGHT HAND</strong>
    <span>PRIVATE INVESTIGATOR</span>
  </span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--ink);
    text-decoration: none;
  }

  .brand.inverted { color: var(--paper-light); }

  .brand-mark {
    position: relative;
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    flex: 0 0 auto;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--copper);
    border-radius: 0.2rem;
    color: var(--paper-light);
    background: var(--pine-950);
    box-shadow: inset 0 -0.28rem 0 var(--red);
  }

  .brand-mark::after {
    position: absolute;
    top: 0;
    left: 0;
    width: 0.2rem;
    height: 100%;
    content: "";
    background: var(--red);
  }

  .brand-mark span { padding-bottom: 0.2rem; font-family: var(--font-display); font-size: 1rem; font-weight: 700; letter-spacing: 0.02em; }

  .brand-copy { display: grid; line-height: 1; }
  .brand-copy strong { color: var(--ink); font-size: 0.89rem; letter-spacing: 0.16em; }
  .brand-copy span { margin-top: 0.3rem; color: var(--red-dark); font-size: 0.57rem; font-weight: 750; letter-spacing: 0.14em; }
  .inverted .brand-copy strong { color: var(--copper-light); }
  .inverted .brand-copy span { color: var(--paper-light); }
  .compact .brand-copy { display: none; }
</style>
