---
import ArrowIcon from "./ArrowIcon.astro";
import BrandMark from "./BrandMark.astro";
import { footerNavigation, siteConfig } from "@/data/site";
import { pathFor } from "@/utils/urls";
---

<footer class="site-footer">
  <div class="shell footer-main">
    <div class="footer-brand">
      <BrandMark inverted />
      <p>{siteConfig.descriptor}</p>
      <p class="safety-line">This site is not monitored for emergencies. If someone is in immediate danger, call 911.</p>
    </div>
    <nav class="footer-nav" aria-label="Footer">
      <p class="footer-label">Explore</p>
      {footerNavigation.map((item) => <a href={pathFor(item.href)}>{item.label}</a>)}
    </nav>
    <div class="footer-contact">
      <p class="footer-label">Start here</p>
      <a href={`tel:${siteConfig.phoneHref}`}>{siteConfig.phoneDisplay}</a>
      <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      <a class="process-link" href={siteConfig.processServiceUrl} target="_blank" rel="noopener noreferrer">
        Need documents served?<br />Visit process service <ArrowIcon external />
      </a>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© {new Date().getFullYear()} Right Hand Private Investigator</span>
    <span>Idaho-focused investigative support</span>
  </div>
</footer>

<style>
  .site-footer { color: var(--paper); background: var(--pine-950); }
  .footer-main { display: grid; grid-template-columns: 1.5fr 0.65fr 1fr; gap: clamp(2.5rem, 7vw, 7rem); padding-block: 5rem 4rem; }
  .footer-brand > p { max-width: 30rem; margin: 1.5rem 0 0; color: var(--sage-light); }
  .footer-brand .safety-line { max-width: 34rem; color: color-mix(in srgb, var(--paper) 70%, transparent); font-size: 0.82rem; }
  .footer-label { margin: 0 0 1.25rem; color: var(--copper-light); font-size: 0.69rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; }
  .footer-nav,
  .footer-contact { display: flex; flex-direction: column; align-items: flex-start; gap: 0.7rem; }
  .footer-nav a,
  .footer-contact > a { color: var(--paper); text-decoration: none; }
  .footer-nav a:hover,
  .footer-contact > a:hover { color: var(--copper-light); }
  .footer-contact .process-link { display: inline-flex; align-items: flex-end; gap: 0.5rem; margin-top: 1rem; color: var(--copper-light); font-weight: 700; }
  .footer-bottom { display: flex; justify-content: space-between; gap: 1rem; padding-block: 1.25rem; border-top: 1px solid rgb(255 255 255 / 13%); color: color-mix(in srgb, var(--paper) 60%, transparent); font-size: 0.73rem; }
  @media (max-width: 48rem) {
    .footer-main { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
    .footer-bottom { flex-direction: column; }
  }
  @media (max-width: 31rem) {
    .footer-main { grid-template-columns: 1fr; }
    .footer-brand { grid-column: auto; }
  }
</style>
