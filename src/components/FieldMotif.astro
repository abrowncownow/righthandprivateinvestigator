---
interface Props {
  variant?: "contours" | "grid" | "coordinates";
}

const { variant = "contours" } = Astro.props;
---

<div class:list={["field-motif", `field-motif--${variant}`]} aria-hidden="true">
  {variant === "contours" && (
    <div class="contour-set">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
  )}
  {variant === "coordinates" && <span>43.6° N / 116.2° W</span>}
</div>

<style>
  .field-motif { pointer-events: none; user-select: none; }
  .field-motif--contours,
  .contour-set { position: relative; width: 100%; height: 100%; }
  .contour-set span {
    position: absolute;
    border: 1px solid currentColor;
    border-radius: 47% 53% 44% 56% / 55% 43% 57% 45%;
    transform: rotate(-7deg);
  }
  .contour-set span:nth-child(1) { inset: 2% 0 5% 1%; }
  .contour-set span:nth-child(2) { inset: 10% 8% 13% 9%; border-radius: 55% 45% 51% 49% / 47% 57% 43% 53%; transform: rotate(-4deg); }
  .contour-set span:nth-child(3) { inset: 19% 17% 22% 18%; border-radius: 43% 57% 47% 53% / 58% 45% 55% 42%; transform: rotate(2deg); }
  .contour-set span:nth-child(4) { inset: 29% 26% 31% 27%; border-radius: 51% 49% 59% 41% / 44% 55% 45% 56%; transform: rotate(-3deg); }
  .contour-set span:nth-child(5) { inset: 40% 37% 41% 38%; border-radius: 58% 42% 45% 55% / 51% 41% 59% 49%; transform: rotate(5deg); }
  .field-motif--grid {
    background-image:
      linear-gradient(to right, currentColor 1px, transparent 1px),
      linear-gradient(to bottom, currentColor 1px, transparent 1px),
      linear-gradient(to right, currentColor 1px, transparent 1px),
      linear-gradient(to bottom, currentColor 1px, transparent 1px);
    background-size: 28px 28px, 28px 28px, 112px 112px, 112px 112px;
    opacity: 0.08;
  }
  .field-motif--coordinates span { font-size: 0.62rem; font-weight: 700; letter-spacing: 0.14em; }
</style>
