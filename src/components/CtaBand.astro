---
import ArrowIcon from "./ArrowIcon.astro";
import { pathFor } from "@/utils/urls";

interface Props {
  title: string;
  copy: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  title,
  copy,
  primaryLabel = "Discuss an assignment",
  primaryHref = "/contact/#contact-form",
  secondaryLabel,
  secondaryHref
} = Astro.props;
---

<section class="cta-band section--copper">
  <div class="shell cta-band__inner">
    <div>
      <p class="eyebrow">NEXT / STEP</p>
      <h2>{title}</h2>
      <p>{copy}</p>
    </div>
    <div class="cta-band__actions">
      <a class="button button--dark" href={pathFor(primaryHref)}>{primaryLabel} <ArrowIcon /></a>
      {secondaryLabel && secondaryHref && <a class="text-link text-link--dark" href={pathFor(secondaryHref)}>{secondaryLabel} <ArrowIcon /></a>}
    </div>
  </div>
</section>

<style>
  .cta-band { padding-block: clamp(4rem, 8vw, 7rem); border-top: 0.35rem solid var(--red-dark); }
  .cta-band .eyebrow { color: var(--pine-950); }
  .cta-band__inner { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 3rem; }
  .cta-band h2 { max-width: 16ch; margin: 0; color: var(--pine-950); }
  .cta-band p:not(.eyebrow) { max-width: 42rem; margin: 1.25rem 0 0; color: color-mix(in srgb, var(--pine-950) 80%, transparent); }
  .cta-band__actions { display: flex; min-width: 16rem; flex-direction: column; align-items: stretch; gap: 1rem; }
  .cta-band__actions .text-link { justify-content: center; }
  @media (max-width: 48rem) { .cta-band__inner { grid-template-columns: 1fr; align-items: start; } }
</style>
